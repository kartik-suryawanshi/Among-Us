# Server Port (default 4000 matches Vite frontend fallback, or 5000)
PORT=4000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated or single URL)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitstory
DATABASE_SSL=false

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# GitHub API Configuration
GITHUB_TOKEN=
GITHUB_API_TIMEOUT_MS=10000
